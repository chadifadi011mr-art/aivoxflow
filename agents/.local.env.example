# Local secret values for the content pipeline — NEVER committed.
# Copy to agents/.local.env and fill in with Notepad (one value per line).
#
# Get a free Gemini key: https://aistudio.google.com -> Get API key -> Create
#
# Usage (PowerShell, from the repo root):
#   .\agents\run-local.ps1 doctor          # validate config + key (never prints the key)
#   .\agents\run-local.ps1 run <stage>     # run one pipeline stage
#   .\agents\run-local.ps1 scheduler --once

AIVOXFLOW_AI_PROVIDER=gemini
AIVOXFLOW_AI_MODEL=gemini-flash-latest
AIVOXFLOW_AI_API_KEY=

# Research search — tavily works WITHOUT a key: free keyless mode, rate-limited,
# no account and no credit card (docs.tavily.com/documentation/keyless).
# Optionally add AIVOXFLOW_SEARCH_API_KEY for 1,000 free credits/month (no card).
AIVOXFLOW_SEARCH_PROVIDER=tavily
AIVOXFLOW_SEARCH_API_KEY=
