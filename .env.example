# AIVOXFLOW — environment template (placeholders only).
# Copy to .env and fill locally. NEVER commit .env or real secrets.
# Rule: host/domain values stay configurable; no temporary domain may be
# hardcoded into application logic, canonical URLs, or generated assets.

# --- Site ---
AIVOXFLOW_SITE_URL=https://your-free-subdomain.example
AIVOXFLOW_SITE_URL_LOCAL=http://localhost:8080
AIVOXFLOW_ENVIRONMENT=development

# --- AI workflow (phase one: mocks only; budget defaults = 0) ---
AIVOXFLOW_AI_PROVIDER=mock
AIVOXFLOW_AI_API_KEY=
AIVOXFLOW_AI_MODEL=
AIVOXFLOW_AI_TIMEOUT_SECONDS=60
AIVOXFLOW_AI_MAX_RETRIES=3

# --- Budget & safety ceilings (keep at 0 until a provider is approved) ---
AIVOXFLOW_AI_BUDGET_USD_DAILY=0
AIVOXFLOW_AI_BUDGET_USD_MONTHLY=0
AIVOXFLOW_AI_DAILY_ARTICLE_LIMIT=0
AIVOXFLOW_AI_MAX_CONCURRENT_JOBS=1

# --- Publication gate (draft-only unless admin explicitly enables) ---
AIVOXFLOW_AUTONOMOUS_PUBLISH=off
AIVOXFLOW_EMERGENCY_STOP=on

# --- Scheduler ---
# Documented honestly: WP-Cron/traffic-triggered schedulers are NOT precise.
AIVOXFLOW_SCHEDULER_MODE=manual
