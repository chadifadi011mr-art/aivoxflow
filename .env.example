# AIVOXFLOW — environment template (placeholders only).
# Copy to .env and fill locally. NEVER commit .env or real secrets.
# Rule: host/domain values stay configurable; no temporary domain may be
# hardcoded into application logic, canonical URLs, or generated assets.

# --- Site (the only production requirement) ---
# When unset, canonical URLs, sitemap.xml, robots.txt and feeds are omitted
# rather than guessed.
AIVOXFLOW_SITE_URL=https://your-domain.example
# Optional sub-path deployment, e.g. /my-repo on GitHub Pages
AIVOXFLOW_BASE_PATH=
AIVOXFLOW_ENVIRONMENT=development
# Production hosts set AIVOXFLOW_ENVIRONMENT=production (netlify.toml / vercel.json
# do it for you). In that mode the build FAILS if AIVOXFLOW_SITE_URL is empty,
# so a missing URL can never publish a site without canonicals, sitemap or feeds.

# --- Language (defaults: en / en_US) ---
AIVOXFLOW_LANGUAGE=en
AIVOXFLOW_LOCALE=en_US

# --- Real reader channels (both stay OFF when empty) ---
# A monitored address is published on /contact/ only when set.
AIVOXFLOW_CONTACT_EMAIL=
# A newsletter form is rendered only when a POST endpoint exists.
AIVOXFLOW_NEWSLETTER_ACTION=

# --- Measurement (opt-in; nothing loads when unset) ---
# See docs/MEASUREMENT.md. The CSP is widened for these origins only.
AIVOXFLOW_ANALYTICS_SCRIPT=
AIVOXFLOW_ANALYTICS_ENDPOINT=

# --- AI workflow (content agents) ---
# Text:   mock | ollama | gemini | openai | openai-compatible | anthropic | openrouter
# Images: local | pollinations | a1111 | gemini | openai
#
# Zero-key, zero-cost setup (see docs/FREE_STACK.md):
#   AIVOXFLOW_AI_PROVIDER=ollama      AIVOXFLOW_AI_MODEL=qwen2.5:14b
#   AIVOXFLOW_IMAGE_PROVIDER=local    (or pollinations / a1111)
#
# Run `node agents/doctor.mjs --probe` after filling these in — it lists the
# models your key (or local runtime) can actually use.
AIVOXFLOW_AI_PROVIDER=mock
AIVOXFLOW_AI_API_KEY=
AIVOXFLOW_AI_MODEL=
AIVOXFLOW_AI_BASE_URL=
AIVOXFLOW_AI_TIMEOUT_SECONDS=120
AIVOXFLOW_AI_MAX_RETRIES=4
AIVOXFLOW_AI_MAX_OUTPUT_TOKENS=8192
# Ollama only: context window. Defaults in Ollama are too small for a long draft.
AIVOXFLOW_AI_NUM_CTX=16384

# Image generation. `local` needs no key and no network.
AIVOXFLOW_IMAGE_PROVIDER=local
AIVOXFLOW_IMAGE_API_KEY=
AIVOXFLOW_IMAGE_MODEL=
AIVOXFLOW_IMAGE_BASE_URL=
AIVOXFLOW_IMAGE_NEGATIVE=
AIVOXFLOW_IMAGE_STEPS=28
AIVOXFLOW_IMAGE_CFG=6.5
AIVOXFLOW_IMAGE_SAMPLER=DPM++ 2M Karras

# Research. Without a provider the pipeline stops before writing anything.
# tavily works with no key at all (free keyless mode, rate-limited); brave needs a key.
AIVOXFLOW_SEARCH_PROVIDER=none
AIVOXFLOW_SEARCH_API_KEY=

# --- Budget & safety ceilings (0 = no ceiling; spend is logged per job) ---
AIVOXFLOW_AI_BUDGET_USD_DAILY=0
AIVOXFLOW_AI_BUDGET_USD_MONTHLY=0
AIVOXFLOW_AI_PRICE_INPUT_PER_1K=0
AIVOXFLOW_AI_PRICE_OUTPUT_PER_1K=0
AIVOXFLOW_AI_DAILY_ARTICLE_LIMIT=0
AIVOXFLOW_AI_MAX_CONCURRENT_JOBS=1

# --- Publication gate (draft-only unless admin explicitly enables) ---
AIVOXFLOW_AUTONOMOUS_PUBLISH=off
AIVOXFLOW_EMERGENCY_STOP=on

# --- Scheduler ---
# Documented honestly: WP-Cron/traffic-triggered schedulers are NOT precise.
AIVOXFLOW_SCHEDULER_MODE=manual
