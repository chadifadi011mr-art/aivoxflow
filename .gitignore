# Secrets — never commit
.env
*.pem
*.key
credentials*.json

# Dependencies / build output
node_modules/
vendor/
dist/
dist.tmp/
dist.old/
build/
.wp-env.json

# Operator status page (site/admin.mjs) — local-only snapshot of the publishing
# state; git-ignored so it is never committed and never deployed to the host.
admin-status.html

# Generated social cards are committed (builds must not need a browser);
# only the renderer's scratch files are ignored.
site/assets-src/og/*.tmp.png

# WordPress-specific (if that stack is chosen)
wp-config.php
/wp-content/uploads/
/wp-content/cache/

# Backups & exports (free-phase rule 7: keep them local/private)
backups/
backup/
*.sql
*.sql.gz

# Logs & OS noise
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local agent workspace data (not part of the product)
.workbuddy-ai/

# Content-agent working state: job logs, drafts and draft artwork.
# Only promoted articles and their images enter site/data and site/assets-src.
# content/calendar.json IS tracked — it is the publishing queue.
# content/SCHEDULER_STOP is tracked on purpose — committing it halts automation.
# content/unpublished/ holds articles pulled back by --unpublish: local, private.
content/jobs/
content/drafts/
content/unpublished/
content/scheduler.log

# Deployment (deploy/deploy.mjs): credentials and one-shot artefacts stay local.
deploy/.ftp.env
deploy/.curlcfg.tmp
deploy/*.zip
deploy/backup-*/

# Local agent secrets (run-local.ps1 loads this; .example template is tracked).
agents/.local.env
