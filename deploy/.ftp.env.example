# AIVOXFLOW deployment credentials — LOCAL ONLY.
#
#   cp deploy/.ftp.env.example deploy/.ftp.env    then fill this in.
#
# deploy/.ftp.env is gitignored and the password is passed to curl through a
# temp config file, so it never appears on a command line or in a log.
#
# Where to find each value (Hostinger hPanel, free plan):
#   Files -> FTP Accounts  -> host, username and the password you set there.
AIVOXFLOW_FTP_HOST=ftp.aivoxflow.unaux.com
AIVOXFLOW_FTP_USER=ezyro_XXXXXXX
AIVOXFLOW_FTP_PASS=

# The FTP account usually opens in the account root, so the site goes into
# public_html/. If yours opens directly inside public_html, set this to . instead.
AIVOXFLOW_FTP_REMOTE_ROOT=public_html

# Set to 1 only if plain FTP is rejected and the host requires explicit TLS.
AIVOXFLOW_FTP_SSL=0

# Public URL the site is built with — must match the domain on the host.
AIVOXFLOW_SITE_URL=https://aivoxflow.unaux.com
